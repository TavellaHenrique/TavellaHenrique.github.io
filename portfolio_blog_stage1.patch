+def test_renderer_does_not_allow_raw_html() -> None:
+    renderer = MarkdownRenderer()
+
+    html = renderer.render("<script>alert('x')</script>")
+
+    assert "<script>" not in html
+    assert "&lt;script&gt;" in html
